# This is an example environment file
# Copy this to .env and fill in your values

# ============================================
# DATABASE
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/starbook

# ============================================
# AWS CONFIGURATION
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key

# S3 Buckets
S3_MEDIA_BUCKET=starbook-media-dev
S3_WEBSITE_BUCKET=starbook-website-dev

# CloudFront
CLOUDFRONT_DISTRIBUTION_ID=your_distribution_id
CLOUDFRONT_DOMAIN=your_domain.cloudfront.net

# ============================================
# AUTHENTICATION
# ============================================
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=your-secret-key-change-this-in-production

# OAuth Providers (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Upload limits
MAX_FILE_SIZE_MB=100
MAX_FILES_PER_UPLOAD=10

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ============================================
# EMAIL (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@starbook.app

# ============================================
# REDIS (Optional - for caching/sessions)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_VIDEO_EDITING=true
ENABLE_COLLABORATION=false
ENABLE_ANALYTICS=true
